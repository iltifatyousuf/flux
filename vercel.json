{
  "buildCommand": "cd artifacts/flux-file-intelligence && pnpm run build",
  "outputDirectory": "artifacts/flux-file-intelligence/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://flux-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

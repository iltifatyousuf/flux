# FLUX File Intelligence environment template
# Copy this file to .env for local development and replace placeholders.
# Never commit a real .env file or share secret values.

# Optional server-side OpenAI provider.
# The API falls back to deterministic local processing when this is unavailable.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

# Whop billing configuration.
# These values identify your Whop company/product/plan; they are not API credentials.
# The server obtains the Whop API credential through the connected Replit Whop integration.
WHOP_COMPANY_ID=biz_replace_me
WHOP_PLAN_ID=plan_replace_me
WHOP_PRODUCT_ID=prod_replace_me
WHOP_PLAN_PURCHASE_URL=https://whop.com/checkout/plan_replace_me

# Replit supplies these automatically when the Whop integration is connected.
# Do not copy or hardcode their values into this file:
# REPLIT_CONNECTORS_HOSTNAME
# REPL_IDENTITY
# WEB_REPL_RENEWAL